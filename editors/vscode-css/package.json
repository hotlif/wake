{
  "name": "crab-css",
  "private": true,
  "displayName": "Crab CSS",
  "description": "CSS language intelligence for @crab-dev/css tagged templates.",
  "version": "0.1.3",
  "publisher": "crab-dev",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hotlif/wake.git",
    "directory": "editors/vscode-css"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "css",
    "css-in-js",
    "wake",
    "crab"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/**",
    "server/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onCommand:crabCss.restartLanguageServer",
    "onCommand:crabCss.showOutput"
  ],
  "contributes": {
    "semanticTokenTypes": [
      {
        "id": "crabCssValue",
        "description": "A CSS identifier used as a value inside an @crab-dev/css template."
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "crabCssValue": [
            "support.constant.property-value.css"
          ]
        }
      }
    ],
    "commands": [
      {
        "command": "crabCss.restartLanguageServer",
        "title": "Crab CSS: Restart Language Server"
      },
      {
        "command": "crabCss.showOutput",
        "title": "Crab CSS: Show Output"
      }
    ],
    "configuration": {
      "title": "Crab CSS",
      "properties": {
        "crabCss.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable Crab CSS language intelligence."
        },
        "crabCss.validation.mode": {
          "type": "string",
          "enum": [
            "off",
            "onType",
            "onSave"
          ],
          "default": "onType",
          "description": "Validate while typing and on save, only on save, or not at all."
        },
        "crabCss.format.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable explicit document and range formatting for Crab CSS templates."
        },
        "crabCss.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace communication with the Crab CSS language server."
        }
      }
    }
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "compile": "node scripts/clean.mjs && tsc -p tsconfig.json --noEmit && node scripts/build.mjs",
    "check": "npm run compile && node ../../npm/wake/bin/wake.mjs test test/manifest.test.mjs",
    "package:vsix": "npm run compile && node scripts/package-vsix.mjs",
    "test:extension": "npm run compile && node test/run-extension-host.mjs",
    "update:css-data": "node scripts/update-css-data.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/vscode": "1.96.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "7.0.2",
    "vscode-css-languageservice": "6.3.10"
  }
}

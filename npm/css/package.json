{
  "name": "@crab-dev/css",
  "version": "0.1.25",
  "description": "Type-safe, zero-runtime CSS authoring for Wake",
  "keywords": [
    "css",
    "css-in-js",
    "wake",
    "zero-runtime"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hotlif/wake.git",
    "directory": "npm/css"
  },
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs",
      "default": "./index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.cjs",
    "index.mjs",
    "index.d.ts",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.14 <27"
  },
  "scripts": {
    "test": "wake test test/runtime.test.mjs",
    "typecheck": "yarn exec pnpify tsc -p test/tsconfig.json",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@yarnpkg/pnpify": "4.1.7",
    "typescript": "6.0.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

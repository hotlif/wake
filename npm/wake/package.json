{
  "name": "@crab-dev/wake",
  "version": "0.1.19",
  "description": "Wake native web build tools for Node.js",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hotlif/wake.git"
  },
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./experimental": {
      "types": "./experimental.d.ts",
      "import": "./experimental.mjs",
      "require": "./experimental.cjs"
    },
    "./internal/components-runtime": {
      "types": "./internal/components-runtime.d.ts",
      "import": "./internal/components-runtime.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "wake": "./bin/wake.mjs"
  },
  "napi": {
    "binaryName": "wake"
  },
  "files": [
    "bin",
    "internal",
    "*.cjs",
    "*.mjs",
    "index.d.ts",
    "experimental.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "engines": {
    "node": ">=22.14 <27"
  },
  "dependencies": {
    "@crab-dev/rc-alert": "^0.0.2",
    "@crab-dev/rc-button": "^0.0.2",
    "@crab-dev/rc-dialog": "^0.0.2",
    "@crab-dev/rc-drawer": "^0.0.2",
    "@crab-dev/rc-empty": "^0.0.2",
    "@crab-dev/rc-line-edit": "^0.0.4",
    "@crab-dev/rc-number-edit": "^0.0.2",
    "@crab-dev/rc-segmented": "^0.0.2",
    "@crab-dev/rc-select": "^0.0.3",
    "@crab-dev/rc-switch": "^0.0.2",
    "@crab-dev/rc-tag": "^0.0.2",
    "@crab-dev/rc-text-edit": "^0.0.1",
    "@crab-dev/rc-tooltip": "^0.0.2",
    "@crab-dev/rc-tree": "^0.1.2",
    "@crab-dev/css": "0.1.19",
    "lucide-react": "^1.23.0"
  },
  "peerDependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "optionalDependencies": {
    "@crab-dev/wake-darwin-arm64": "0.1.19",
    "@crab-dev/wake-darwin-x64": "0.1.19",
    "@crab-dev/wake-linux-arm64-gnu": "0.1.19",
    "@crab-dev/wake-linux-x64-gnu": "0.1.19",
    "@crab-dev/wake-win32-x64-msvc": "0.1.19"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

{
  "name": "@crab-dev/wake",
  "version": "0.1.23",
  "description": "Wake native web build tools for Node.js",
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hotlif/wake.git"
  },
  "type": "module",
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.cjs"
    },
    "./experimental": {
      "types": "./experimental.d.ts",
      "import": "./experimental.mjs",
      "require": "./experimental.cjs"
    },
    "./test": {
      "types": "./test.d.ts",
      "import": "./test.mjs",
      "require": "./test.cjs"
    },
    "./test/react": {
      "types": "./test-react.d.ts",
      "import": "./test-react.mjs",
      "require": "./test-react.cjs"
    },
    "./internal/components-runtime": {
      "types": "./internal/components-runtime.d.ts",
      "import": "./internal/components-runtime.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": "./bin/wake.mjs",
  "napi": {
    "binaryName": "wake"
  },
  "files": [
    "bin",
    "internal",
    "*.cjs",
    "*.mjs",
    "index.d.ts",
    "experimental.d.ts",
    "test.cjs",
    "test.mjs",
    "test.d.ts",
    "test-react.cjs",
    "test-react.mjs",
    "test-react.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "engines": {
    "node": ">=22.14 <27"
  },
  "dependencies": {
    "@crab-dev/css": "0.1.23",
    "@crab-dev/rc-alert": "^0.0.2",
    "@crab-dev/rc-button": "^0.0.2",
    "@crab-dev/rc-dialog": "^0.0.2",
    "@crab-dev/rc-drawer": "^0.0.2",
    "@crab-dev/rc-empty": "^0.0.2",
    "@crab-dev/rc-line-edit": "^0.0.4",
    "@crab-dev/rc-number-edit": "^0.0.2",
    "@crab-dev/rc-segmented": "^0.0.2",
    "@crab-dev/rc-select": "^0.0.3",
    "@crab-dev/rc-switch": "^0.0.2",
    "@crab-dev/rc-tag": "^0.0.2",
    "@crab-dev/rc-text-edit": "^0.0.1",
    "@crab-dev/rc-tooltip": "^0.0.2",
    "@crab-dev/rc-tree": "^0.1.2",
    "clipboardy": "5.3.2",
    "lucide-react": "^1.23.0",
    "open": "11.0.0",
    "string-width": "8.2.2"
  },
  "peerDependencies": {
    "react": ">=19.2.8 <19.3.0",
    "react-dom": ">=19.2.8 <19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "optionalDependencies": {
    "@crab-dev/wake-darwin-arm64": "0.1.23",
    "@crab-dev/wake-darwin-x64": "0.1.23",
    "@crab-dev/wake-linux-arm64-gnu": "0.1.23",
    "@crab-dev/wake-linux-x64-gnu": "0.1.23",
    "@crab-dev/wake-win32-x64-msvc": "0.1.23"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

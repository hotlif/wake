{
  "name": "wake-react-docs-fixture",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "cargo run -q --manifest-path ../../Cargo.toml -p wake_cli -- docs dev .",
    "docs:build": "cargo run -q --manifest-path ../../Cargo.toml -p wake_cli -- docs build .",

{
  "name": "wake-workspace",
  "private": true,
  "version": "0.1.26",
  "type": "module",
  "packageManager": "yarn@4.16.0",
  "workspaces": [
    "npm/*",
    "editors/vscode-css"
  ],
  "scripts": {
    "architecture:check": "node scripts/check-architecture.mjs",
    "architecture:test": "wake test scripts/check-architecture.test.mjs",
    "browser:conformance:check": "node scripts/check-system-browser-conformance.mjs --manifest-only true",
    "browser:conformance:test": "node scripts/check-system-browser-conformance.test.mjs",
    "docs:dev": "cargo run -q -p wake_cli -- docs dev .",
    "docs:build": "cargo run -q -p wake_cli -- docs build .",
    "docs:check": "node scripts/check-docs.mjs && node --test crates/wake_docs/runtime/search.test.mjs",
    "fixture:2k:check": "node fixtures/2k-modules/verify-project.mjs",
    "native:build": "cargo build -p wake_test_host -p wake_cli --release --locked --offline && yarn exec napi build --platform --release --strip --cwd crates/wake_node --output-dir ../../npm/wake --package-json-path ../../npm/wake/package.json --no-js --dts native.d.ts -- --locked --offline && node scripts/stage-test-host.mjs",
    "npm:test": "yarn npm:test:wake && yarn npm:test:css",
    "npm:test:wake": "node --import ./npm/wake/test/select-built-native.mjs ./npm/wake/bin/wake.mjs test npm/wake/test/cli.test.mjs npm/wake/test/components-state.test.mjs npm/wake/test/console.test.mjs npm/wake/test/terminal.test.mjs && yarn npm:test:wake:addon",
    "npm:test:wake:addon": "node --import ./npm/wake/test/select-built-native.mjs --test npm/wake/test/api.test.mjs npm/css/test/realm.node.mjs && yarn npm:test:wake:federation",
    "npm:test:wake:federation": "node --test npm/wake/test/federation.test.mjs npm/wake/test/federation-react.test.mjs",
    "npm:test:css": "yarn workspace @crab-dev/css test",
    "npm:typecheck": "yarn npm:typecheck:wake && yarn npm:typecheck:css",
    "npm:typecheck:wake": "yarn exec pnpify tsc -p npm/wake/test/tsconfig.json",
    "npm:typecheck:css": "yarn workspace @crab-dev/css typecheck",
    "typescript:7:check": "yarn exec pnpify node scripts/check-typescript-7.mjs",
    "test262:es2024": "node scripts/run-test262.mjs",
    "npm:pack:check": "node scripts/check-npm-packs.mjs",
    "npm:consumer:check": "node scripts/check-npm-consumer.mjs",
    "pnp:conformance:check": "node scripts/check-pnp-conformance.mjs",
    "yarn:lock:check": "node scripts/check-yarn-lock.mjs",
    "pnp:components:check": "node scripts/check-components-pnp.mjs",
    "release:check": "node scripts/check-release-coverage.mjs",
    "vscode:css:check": "yarn workspace crab-css check",
    "versions:check": "node scripts/check-versions.mjs"
  },
  "dependencies": {
    "@crab-dev/css": "0.1.26",
    "@crab-dev/rc-alert": "^0.0.2",
    "@crab-dev/rc-button": "^0.0.2",
    "@crab-dev/rc-card": "^0.0.2",
    "@crab-dev/rc-dialog": "^0.0.2",
    "@crab-dev/rc-drawer": "^0.0.2",
    "@crab-dev/rc-empty": "^0.0.2",
    "@crab-dev/rc-line-edit": "^0.0.4",
    "@crab-dev/rc-number-edit": "^0.0.2",
    "@crab-dev/rc-prose": "^0.0.2",
    "@crab-dev/rc-segmented": "^0.0.2",
    "@crab-dev/rc-select": "^0.0.3",
    "@crab-dev/rc-switch": "^0.0.2",
    "@crab-dev/rc-tag": "^0.0.2",
    "@crab-dev/rc-text-edit": "^0.0.1",
    "@crab-dev/rc-tooltip": "^0.0.2",
    "@crab-dev/rc-tree": "^0.1.2",
    "lucide-react": "^1.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@crab-dev/wake": "workspace:*",
    "@napi-rs/cli": "3.7.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@yarnpkg/parsers": "3.1.0",
    "@yarnpkg/pnpify": "4.1.7",
    "buffer-image-size": "0.6.4",
    "corepack": "0.34.6",
    "csstype": "3.2.3",
    "entities": "7.0.1",
    "federation-loose-envify": "npm:loose-envify@1.4.0",
    "federation-object-assign": "npm:object-assign@4.1.1",
    "federation-react-dom17": "npm:react-dom@17.0.2",
    "federation-react-dom18": "npm:react-dom@18.3.1",
    "federation-react17": "npm:react@17.0.2",
    "federation-react18": "npm:react@18.3.1",
    "federation-scheduler17": "npm:scheduler@0.20.2",
    "federation-scheduler18": "npm:scheduler@0.23.2",
    "happy-dom": "20.11.6",
    "typescript": "6.0.2",
    "whatwg-mimetype": "3.0.0",
    "ws": "8.21.3"
  },
  "dependenciesMeta": {
    "@types/react": {
      "unplugged": true
    },
    "buffer-image-size": {
      "unplugged": true
    },
    "csstype": {
      "unplugged": true
    },
    "entities": {
      "unplugged": true
    },
    "happy-dom": {
      "unplugged": true
    },
    "whatwg-mimetype": {
      "unplugged": true
    },
    "ws": {
      "unplugged": true
    }
  }
}
